# Local laptop and Jenkins pull/push talk to s3manager over HTTPS.
# Copy secrets to `.env.local` (gitignored via `*.local`). Do not put real passwords here.
# HTTP login is Traefik BasicAuth (Jenkins id `s3manager-http`), not MinIO root unless you reuse it.
S3MANAGER_URL=https://minio-adminer.balashov-maxim.ru
S3MANAGER_INSTANCE=Default
S3MANAGER_USER=
S3MANAGER_PASSWORD=
