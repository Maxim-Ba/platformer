# Local laptop push (`npm run assets:push` / pre-push) talks to s3manager over HTTPS.
# Copy secrets to `.env.local` (gitignored via `*.local`). Do not put real passwords here.
# HTTP login is Traefik BasicAuth (Jenkins id `s3manager-http`), not MinIO root unless you reuse it.
S3MANAGER_URL=https://minio-adminer.balashov-maxim.ru
S3MANAGER_INSTANCE=Default
S3MANAGER_USER=
S3MANAGER_PASSWORD=

# Jenkins / in-cluster `assets:pull` still uses the MinIO S3 API (`mc`), not the admin UI.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Jenkins credentials id `minio-assets` injects MINIO_USER / MINIO_PASS at pull time (not for this file).
