#!/bin/sh
# Task 3.3: publish public/assets/ via s3manager HTTPS before git push reaches GitHub.
# Install: git config core.hooksPath scripts/git-hooks
# Credentials: S3MANAGER_USER / S3MANAGER_PASSWORD in .env.local, or a TTY prompt.
# IDE/GUI push without TTY and without .env.local: git push --no-verify.
#
# Operator 7.4 (do not run in this hook): after prod playtest from /media/,
#   git rm --cached -- public/assets/**/*.png public/assets/**/*.svg public/assets/**/*.json
# then commit gitignore + .gitkeep (do not rewrite history).
set -e
cd "$(git rev-parse --show-toplevel)"
npm run assets:push
