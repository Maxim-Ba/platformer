# Example only — do not apply this file with live credentials and do not commit real keys.
# The live Secret is created from Jenkins credentials (same pattern as dockerhub-secret)
# and is not committed to git.
apiVersion: v1
kind: Secret
metadata:
  name: platformer-minio
  namespace: platformer
type: Opaque
stringData:
  MINIO_ROOT_USER: changeme
  MINIO_ROOT_PASSWORD: REPLACE_ME
