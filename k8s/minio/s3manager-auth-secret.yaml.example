# Task 1.4 / 3.1 — Example only. Do not apply this file with live htpasswd
# and do not commit real BasicAuth hashes.
#
# Args: Traefik basicAuth Secret key `users` (htpasswd lines); placeholders
#       only (changeme / REPLACE_ME).
# Returns: shape of Secret platformer-s3manager-auth in namespace platformer.
#
# The live Secret is created from Jenkins credentials (id s3manager-http)
# via `kubectl create secret ... --dry-run=client | kubectl apply` in
# Jenkinsfile.bootstrap and is not committed to git.
# MUST NOT `kubectl apply -f k8s/minio/s3manager-auth-secret.yaml.example`
# (any target containing secret.yaml.example is forbidden).
#
# HTTP BasicAuth login ≠ MinIO root keys unless the operator chooses the
# same password (task 4.3).
apiVersion: v1
kind: Secret
metadata:
  name: platformer-s3manager-auth
  namespace: platformer
type: Opaque
stringData:
  users: |
    changeme:REPLACE_ME
